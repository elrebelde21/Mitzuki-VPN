# ============================================
# BOT DE TELEGRAM
# ============================================
# Token de tu bot (obtenido de @BotFather)
BOT_TOKEN=TU_TOKEN_AQUI

# IDs de Telegram de los administradores (separados por coma). Tu ID: usa /id en el bot
ADMIN_IDS=66666,77777

# Ruta de la base de datos SQLite
DB_PATH=vaydns.db

# ============================================
# SERVIDOR VPS (donde se instala VayDNS)
# ============================================
DEFAULT_SERVER_IP=TU_IP_DE_LA_VPS
DEFAULT_SERVER_SSH_PORT=22
DEFAULT_SERVER_USERNAME=root
DEFAULT_SERVER_PASSWORD=TU_CONTRASENA_DE_LA_VPS

# Dominio con registro tipo A apuntando a la IP de la VPS (ej: ns.tudominio.com)
DEFAULT_SERVER_DOMAIN=ns.tudominio.com
# Dominio del túnel con registro tipo NS apuntando al dominio de arriba (ej: d.tudominio.com)
DEFAULT_SERVER_TUNNEL_DOMAIN=d.tudominio.com

# Record type inicial: txt, caa, null, cname, a, aaaa, mx, ns, srv
# (luego se puede cambiar desde el bot: Panel Admin -> Record)
DEFAULT_SERVER_RECORD_TYPE=txt
# DNSTT compat (solo funciona con txt)
DEFAULT_SERVER_DNSTT=true
DEFAULT_SERVER_CLIENT=8
DEFAULT_SERVER_PORT=53

# ============================================
# OPCIONES
# ============================================
# true = cualquiera puede crear cuenta / false = solo admin y premium
PUBLIC_MODE=false
# Contacto que se muestra a quien no tiene acceso
OWNER_CONTACT=@tu_usuario
# Link de descarga de la app cliente
APP_DOWNLOAD_URL=https://tu-link-de-descarga.com
